{
  "name": "thefishing-mobile-a",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/finalize-build.mjs && node scripts/audit-bundle.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.accessibility.config.ts",
    "api:check": "wrangler deploy --dry-run --outdir .worker-build",
    "api:dev": "wrangler dev --local --ip 127.0.0.1 --port 8787 --show-interactive-dev-session false",
    "api:deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "fake-indexeddb": "6.2.4",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "linkedom": "0.18.14"
  }
}
